# Dify Secrets Configuration Template
# 사용법: cp secrets.env.example secrets.env 후 값을 실제 환경에 맞게 수정

# Database Password
DB_PASSWORD=difyai123456

# Redis Password
REDIS_PASSWORD=difyai123456

# Secret Key (openssl rand -base64 42로 생성)
# 프로덕션 환경에서는 반드시 새로운 키 생성 필요
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U

# Init Password (선택사항 - 초기 관리자 비밀번호 설정)
INIT_PASSWORD=

# Encrypt Public Key (openssl rand -base64 42로 생성)
# 프로덕션 환경에서는 반드시 새로운 키 생성 필요
ENCRYPT_PUBLIC_KEY=

# Weaviate API Key
WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih

# Sandbox API Key
SANDBOX_API_KEY=dify-sandbox

# Plugin Daemon Key (openssl rand -base64 42로 생성)
